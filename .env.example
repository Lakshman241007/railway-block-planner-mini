# ==============================================================================
# Railway Block Planner — Environment Configuration
# ==============================================================================

# Database Configuration
# SQLite (default for zero-configuration local development and tests):
DATABASE_URL=sqlite:///./railway_block_planner.db

# PostgreSQL configuration example (for containerized / production environments):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway_block_planner

# Set to 'true' to log all SQL queries generated by SQLAlchemy
DATABASE_ECHO=false

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, or * for all)
CORS_ORIGINS=*
